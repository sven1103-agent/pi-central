    "smoke": "node packages/orchestrator/src/cli.ts"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
