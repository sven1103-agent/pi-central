{
  "name": "pi-central",
  "version": "0.4.1",
  "type": "module",
  "description": "Local dashboard that orchestrates multiple sandboxed Pi coding-agent sessions across working directories.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sven1103-agent/pi-central.git"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "pi-central": "bin/pi-central.js"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "workspaces": [
    "packages/protocol",
    "packages/orchestrator",
    "packages/ui"
  ],
  "scripts": {
    "test": "node --test \"packages/*/test/**/*.test.ts\" \"packages/*/test/**/*.test.mjs\" \"scripts/**/*.test.mjs\"",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p packages/ui/tsconfig.json",
    "smoke": "node packages/orchestrator/src/cli.ts",
    "server": "node packages/orchestrator/src/server.ts",
    "ui:dev": "npm run dev --workspace @pi-central/ui",
    "ui:build": "npm run build --workspace @pi-central/ui",
    "check:docs": "node scripts/check-docs.mjs",
    "check:version": "node scripts/check-version.mjs",
    "verify": "npm run typecheck && npm test && npm run check:docs && npm run check:version",
    "build:package": "node scripts/build-package.mjs",
    "pack": "npm run build:package && npm pack",
    "serve:package": "node bin/pi-central.js"
  },
  "dependencies": {
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@types/node": "^22.10.2",
    "esbuild": "^0.28.2",
    "typescript": "^5.7.2"
  }
}
