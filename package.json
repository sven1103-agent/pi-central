{
  "name": "pi-central",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Central station for Pi sessions: orchestrate multiple sandboxed Pi sessions across working directories.",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "workspaces": [
    "packages/protocol",
    "packages/orchestrator",
    "packages/ui"
  ],
  "scripts": {
    "test": "node --test \"packages/*/test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p packages/ui/tsconfig.json",
    "smoke": "node packages/orchestrator/src/cli.ts",
    "server": "node packages/orchestrator/src/server.ts",
    "ui:dev": "npm run dev --workspace @pi-central/ui",
    "ui:build": "npm run build --workspace @pi-central/ui"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
