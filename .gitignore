node_modules/
dist/
*.tgz
.DS_Store

# IDE state (this repo lives inside an opened IntelliJ project)
.idea/

# Local scratch: spike output, captured transcripts, policy files.
spikes/**/out/
*.sb.generated

# Phase 0 spike fixtures
.phase0-tmp/

# TypeScript incremental build info (we run .ts directly, but tsc --noEmit still emits this)
*.tsbuildinfo

# UI build output
packages/ui/dist/

# Packaged artifact (issue #52). Generated by `npm run build:package`; `files` in package.json is
# what decides what actually ships, and `dist/` above already covers `dist/ui`.
bin/

# Screenshots pasted for review, not repository content. Issue #7 tracks real README images.
# `img*.png` rather than `img_*.png`: the paste tool emits `img.png` as well as `img_1.png`, and the
# narrower pattern let the un-suffixed one be committed by a `git add -A` while reviewing a slice.
img*.png
# macOS screenshots are named `Screenshot 2026-11-01 at 15.20.44.png` — with SPACES — so `img*.png`
# does not catch them. Same failure as the line above: this release had one in the working tree, and a
# `git add -A` would have committed a full-desktop capture of a machine into the repository. The real
# README image is `docs/images/dashboard.png` and is deliberately not matched.
Screenshot*.png
# Review reports produced by a subagent while triaging a screenshot. Same failure as the line above:
# they are working files, and `git add -A` during a slice swept one into a PR twice. Named explicitly
# rather than as `*.md` so real documentation can never be caught by it.
transcript-ui-review-report.md
*-review-report.md
# The vulnerability scan's own outputs (scripts/production-sbom.mjs and the workflow). They are
# regenerated on every run and belong in the workflow artifact, not the repository — and a local run
# during a slice would otherwise leave four untracked files that `git add -A` could sweep in.
pi-central-sbom.json
grype.json
grype.sarif
grype.raw.sarif
dependency-vulnerability-report.md
